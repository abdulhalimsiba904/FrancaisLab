# Server-side provider credentials. Copy to .env and fill in the keys locally.
GROQ_API_KEY=
GEMINI_API_KEY=

# Optional model overrides. Defaults are documented in README.md.
GROQ_MODEL=
GEMINI_MODEL=

# Optional server safeguards. Defaults: 20 requests per minute per client IP.
AI_RATE_LIMIT_MAX=
AI_RATE_LIMIT_WINDOW_MS=

# Defaults to 0. Set only for a trusted proxy that overwrites forwarding headers.
TRUST_PROXY_HOPS=

# Optional comma-separated exact browser origins. Blank allows only same-origin requests.
ALLOWED_ORIGINS=
